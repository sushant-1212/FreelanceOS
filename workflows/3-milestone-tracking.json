{
  "name": "3. Project Milestone Tracking & Client Updates",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {}
          ]
        }
      },
      "id": "56b92f30-81b8-4a5d-bfdc-b79adecad662",
      "name": "Daily Milestone Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -656,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, project_id, milestone_name, due_date, status, client_email, client_name\nFROM milestones\nWHERE status != 'completed' AND due_date <= CURRENT_DATE\nORDER BY due_date ASC;",
        "additionalFields": {}
      },
      "id": "9fb75a5a-4008-42f8-9f48-0327ad7d8773",
      "name": "Fetch Active Milestones",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        -448,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "rGqoXtPf1qO1I5nf",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "resource": "chat",
        "prompt": {
          "messages": [
            {
              "content": "=You are a project management assistant. Write a short, friendly progress update for the client based on this milestone data.  Milestone: {{ $json.milestone_name }} Status: {{ $json.status }} Due Date: {{ $json.due_date }} Client Name: {{ $json.client_name }}  Write 2-3 sentences summarizing progress and next steps."
            }
          ]
        },
        "options": {},
        "requestOptions": {}
      },
      "id": "fc04335b-d571-4db4-a57f-9d26729da265",
      "name": "AI Progress Summary",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        -224,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "ii0Z6LYZMT8hhxhp",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "subject": "Project Update",
        "message": "={{ $json.message.content }}",
        "toList": [
          "sushantferia11@gmail.com"
        ],
        "additionalFields": {}
      },
      "id": "8f23c45c-1fa3-4e89-9804-08ad8383a4e9",
      "name": "Send Client Update",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "bqcZiMn4lvCKMa3K",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {},
