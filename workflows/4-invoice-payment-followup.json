    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, project_id, invoice_id, amount, status, days_overdue, client_email, client_name\nFROM invoices\nWHERE status != 'paid' AND days_overdue >= 3\nORDER BY days_overdue DESC;",
